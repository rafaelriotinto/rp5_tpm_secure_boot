        reply(ok=False, error="must run as root (via sudo)"); sys.exit(1)
    os.environ.pop("SSH_ORIGINAL_COMMAND", None)
    sys.exit(main({"provision": provision, "provision-fwkey": provision_fwkey,
                  "enroll": lambda a: record(), "verify": verify, "attack": attack}))
