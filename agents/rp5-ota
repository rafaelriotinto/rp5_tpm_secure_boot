#!/usr/bin/env python3
"""OTA service, unprivileged half (forced command for the 'ota' key, user 'ota').

  status            -> active pair, counter, autoboot.txt, what is staged
  install           stdin: tar (MANIFEST.json, boot.img, boot.sig, rootfs.img)
                    -> unpack to /data/ota/staging, verify every digest against
                    the manifest, refuse a version below the counter, then hand
                    over to rp5-ota-priv (root, via sudo) to write the INACTIVE pair
  tryboot           -> reboot "0 tryboot" (one-shot trial of the other pair)
  commit            -> only on a trial boot: rewrite autoboot.txt (swap), no reboot
  reboot            -> plain reboot

The privileged half does its own checks again; this half exists so that the
network-facing process never runs as root.
"""
import json, os, sys, tarfile
sys.path.insert(0, "/usr/lib"); sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from rp5agent import *  # noqa

STAGING = "/data/ota/staging"
PRIV = "/usr/bin/rp5-ota-priv"
FILES = ("boot.img", "boot.sig", "rootfs.img")


def priv(*args, **kw):
    out = run("sudo", "-n", PRIV, *args, check=False, **kw)   # the helper's JSON carries the error
    try:
        return json.loads(out.decode().strip().splitlines()[-1])
    except (ValueError, IndexError):
        raise Fail(f"privileged helper returned no reply: {out[:200]!r}")


def status(args):
    p = priv("status")
    if not p.get("ok"):
        raise Fail(p.get("error", "status failed"))
    st = {k: v for k, v in p.items() if k not in ("ok", "verb")}
    st["staged"] = None
    try:
        st["staged"] = json.load(open(f"{STAGING}/MANIFEST.json"))
    except (OSError, ValueError):
        pass
    return st


def install(args):
    if fw_tryboot():
        raise Fail("running a trial boot; commit or reboot before installing")
    if not os.path.isdir(os.path.dirname(STAGING)):
        p0 = priv("prepare")      # /data is root-owned; the helper creates /data/ota for us
        if not p0.get("ok"):
            raise Fail(p0.get("error", "prepare failed"))
    os.makedirs(STAGING, mode=0o700, exist_ok=True)
    for fn in os.listdir(STAGING):
        os.remove(os.path.join(STAGING, fn))
    with tarfile.open(fileobj=sys.stdin.buffer, mode="r|*") as tar:
        for m in tar:
            name = os.path.basename(m.name)
            if not m.isfile() or name not in FILES + ("MANIFEST.json",):
                continue
            with open(os.path.join(STAGING, name), "wb") as out, tar.extractfile(m) as src:
                while True:
                    chunk = src.read(1 << 20)
                    if not chunk:
                        break
                    out.write(chunk)
    try:
        man = json.load(open(f"{STAGING}/MANIFEST.json"))
    except (OSError, ValueError):
        raise Fail("no MANIFEST.json in the release")
    for fn in FILES:
        want = man.get("sha256", {}).get(fn)
        have = sha256_file(f"{STAGING}/{fn}") if os.path.exists(f"{STAGING}/{fn}") else None
        if not want or want != have:
            raise Fail(f"{fn}: digest mismatch or missing (manifest {want}, got {have})")
    if man.get("factory"):
        raise Fail("this is the factory image, not a release; it is never installed in the field")
    ver = int(man.get("version", 0))
    c = counter()
    if ver < c:
        raise Fail(f"release version {ver} is below this board's anti-rollback counter {c}")
    p = priv("install", STAGING)
    if not p.get("ok"):
        raise Fail(p.get("error", "install failed"))
    return {"version": ver, "target": p.get("target"), "verified": p.get("verified")}


def simple(verb):
    def h(args):
        p = priv(verb)
        if not p.get("ok"):
            raise Fail(p.get("error", f"{verb} failed"))
        return {k: v for k, v in p.items() if k not in ("ok", "verb")}
    return h


if __name__ == "__main__":
    sys.exit(main({"status": status, "install": install, "tryboot": simple("tryboot"),
                   "commit": simple("commit"), "reboot": simple("reboot")}))
