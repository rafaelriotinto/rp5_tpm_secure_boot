# Dropbear host keys live on the writable data partition, so they persist
# across boots of the read-only root. Loaded as a LATE EnvironmentFile from
# the unit drop-ins: in systemd an EnvironmentFile= overrides Environment=,
# and Yocto's read-only-rootfs support ships /etc/default/dropbear (pointing
# at tmpfs /var/lib/dropbear) as an EnvironmentFile -- so a plain Environment=
# in a drop-in loses. A later EnvironmentFile= wins.
DROPBEAR_RSAKEY_DIR=/data/dropbear
